diff --git a/src/lib_vt_windows.zig b/src/lib_vt_windows.zig
new file mode 100644
index 000000000..5a4fc588d
--- /dev/null
+++ b/src/lib_vt_windows.zig
@@ -0,0 +1,25 @@
+//! CRT-linked Windows C library entry point.
+const std = @import("std");
+const lib = @import("lib_vt.zig");
+
+comptime {
+    _ = lib;
+}
+
+// Preserve the C library's embedder logging and release panic behavior.
+pub const std_options = lib.std_options;
+pub const panic = lib.panic;
+pub const std_options_debug_io = lib.std_options_debug_io;
+
+// Zig 0.16 otherwise exports its minimal DLL entry point, bypassing the
+// CRT startup that runs C++ constructors and destructors. In particular,
+// simdutf's active implementation remains null without its constructor.
+// Declaring the symbol leaves its implementation to the linked CRT:
+// MinGW resolves it to DllMainCRTStartup; MSVC provides _DllMainCRTStartup.
+// This declaration is unused for static libraries, whose consumer owns CRT
+// startup. CRT-free builds use lib_vt.zig and retain Zig's default entry.
+pub extern "c" fn _DllMainCRTStartup(
+    instance: std.os.windows.HINSTANCE,
+    reason: std.os.windows.DWORD,
+    reserved: std.os.windows.LPVOID,
+) callconv(.winapi) std.os.windows.BOOL;
